# Copy this file to ".env" and replace every placeholder. ".env" is git-ignored; never commit real values.
# docker compose reads it automatically.

# SQL Server "sa" password. Must meet SQL Server's complexity rules (8+ chars, upper, lower, digit, symbol).
# Avoid ';' and '=' because the value is placed inside a connection string.
SA_PASSWORD=change-me-Sa-Passw0rd!

# Secret used to sign JWT access tokens. At least 32 characters. Generate one, for example:
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# First administrator, created on startup if it does not exist yet. Leave both empty to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Adm1n-Passw0rd!

# Password of the HTTPS certificate in ./certs/aspnetapp.pfx (see README, "Run with Docker").
HTTPS_CERT_PASSWORD=change-me-cert-password
